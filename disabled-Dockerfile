FROM node:20 AS build-stage

# Establecer el directorio de trabajo dentro del contenedor
WORKDIR /app

# Copiar los archivos de Angular al contenedor
COPY package*.json ./

# Instalar las dependencias
RUN npm install

# Copiar el resto de los archivos de la aplicación
COPY . .

# Compilar la aplicación Angular
RUN npm run build --prod

# Fase de producción con Nginx
FROM nginx:1.25 AS production-stage

# Copiar la aplicación compilada al directorio de Nginx
COPY --from=build-stage /app/dist/tancol-frontend/browser /usr/share/nginx/html

# Copiar la configuración personalizada de Nginx (opcional)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Exponer los puertos 80 y 443 para servir la aplicación en HTTP y HTTPS
EXPOSE 80 443 33

# Iniciar Nginx
CMD ["nginx", "-g", "daemon off;"]
